{
    "name": "webware/query-param-router",
    "description": "Mezzio router that matches routes on query parameters as well as path and HTTP method.",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "router",
        "mezzio",
        "query-param"
    ],
    "homepage": "https://github.com/webinertia/query-param-router/discussions",
    "support": {
        "issues": "https://github.com/webinertia/query-param-router/issues",
        "source": "https://github.com/webinertia/query-param-router",
        "forum": "https://github.com/webinertia/query-param-router/discussions"
    },
    "authors": [
        {
            "name": "Joey (aka Tyrsson) Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": true
        }
    },
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "mezzio/mezzio-router": "^3.15 || ^4.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "laminas/laminas-diactoros": "^3.2",
        "laminas/laminas-stratigility": "^3.10",
        "phpunit/phpunit": "^13.4.4",
        "psr/http-server-handler": "^1.0",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/webware-tools": "^1.0.0-rc.8"
    },
    "autoload": {
        "psr-4": {
            "Webware\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTestIntegration\\Router\\": "test/integration/",
            "WebwareTestAsset\\Router\\": "test/asset/",
            "WebwareTest\\Router\\": "test/unit/"
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Webware\\Router\\ConfigProvider"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --no-coverage --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-html coverage/html --coverage-text",
        "test-integration": "phpunit --colors=always --no-coverage --testsuite \"integration test\"",
        "mutation-test": "infection",
        "test-all": [
            "@test",
            "@test-integration",
            "@mutation-test"
        ]
    }
}
